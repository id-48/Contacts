<?xml version="1.0" encoding="utf-8"?>
<com.contacts.manager.ai.smartdialer.voicemessages.calling.callapp.ads.ui.ShimmerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:background="@color/background"
    android:importantForAccessibility="noHideDescendants">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginStart="@dimen/space_8"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="@dimen/space_8"
        android:layout_marginBottom="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_12"
        android:paddingEnd="@dimen/space_12">

        <View
            android:layout_width="@dimen/avatar_medium"
            android:layout_height="@dimen/avatar_medium"
            android:background="@drawable/bg_shimmer_circle" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_16"
            android:layout_marginEnd="@dimen/space_8"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="13dp"
                android:background="@drawable/bg_shimmer_block" />

            <View
                android:layout_width="120dp"
                android:layout_height="11dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_shimmer_block" />
        </LinearLayout>

        <View
            android:layout_width="72dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_shimmer_block" />
    </LinearLayout>
</com.contacts.manager.ai.smartdialer.voicemessages.calling.callapp.ads.ui.ShimmerLayout>
