<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_40"
    android:paddingTop="56dp"
    android:paddingEnd="@dimen/space_40"
    android:paddingBottom="@dimen/space_24">

    <FrameLayout
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:background="@drawable/bg_search_count">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_search"
            app:tint="@color/primary" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_20"
        android:fontFamily="@font/roboto_bold"
        android:gravity="center"
        android:text="@string/search_hint_title"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        app:fontFamily="@font/roboto_bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:fontFamily="@font/roboto_regular"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/search_hint_body"
        android:textColor="@color/text_muted"
        android:textSize="15sp"
        app:fontFamily="@font/roboto_regular" />
</LinearLayout>
