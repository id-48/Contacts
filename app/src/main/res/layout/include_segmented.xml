<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="240dp"
    android:layout_height="46dp"
    android:layout_gravity="center_horizontal"
    android:background="@drawable/bg_pill_track"
    android:padding="4dp">

    <View
        android:id="@+id/segmentThumb"
        android:layout_width="116dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_pill_thumb" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="2dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/segmentFirst"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="@font/roboto_medium"
            android:gravity="center"
            android:textColor="@color/selector_segment_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/segmentSecond"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="@font/roboto_medium"
            android:gravity="center"
            android:textColor="@color/selector_segment_text"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
