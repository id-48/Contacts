<?xml version="1.0" encoding="utf-8"?>
<com.contacts.manager.ai.smartdialer.voicemessages.calling.callapp.ads.ui.ShimmerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="82dp"
    android:background="@color/ad_small_background"
    android:importantForAccessibility="noHideDescendants">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <View
            android:layout_width="130dp"
            android:layout_height="62dp"
            android:layout_weight="0.1"
            android:background="@drawable/bg_shimmer_block" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:background="@drawable/bg_shimmer_block" />

            <View
                android:layout_width="match_parent"
                android:layout_height="9dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_shimmer_block" />

            <View
                android:layout_width="60dp"
                android:layout_height="9dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_shimmer_block" />
        </LinearLayout>

        <View
            android:layout_width="72dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_shimmer_block" />
    </LinearLayout>
</com.contacts.manager.ai.smartdialer.voicemessages.calling.callapp.ads.ui.ShimmerLayout>
