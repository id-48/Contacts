<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/screen_padding">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="@dimen/icon_button"
            android:layout_height="@dimen/icon_button"
            android:background="@drawable/bg_round_ripple"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_4"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:ellipsize="end"
            android:fontFamily="@font/roboto_bold"
            android:maxLines="1"
            android:text="@string/quick_response"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            app:fontFamily="@font/roboto_bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_32">

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/space_4"
                android:paddingEnd="@dimen/space_4"
                android:paddingBottom="@dimen/space_16"
                android:fontFamily="@font/roboto_regular"
                android:text="@string/quick_response_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                app:fontFamily="@font/roboto_regular" />

            <LinearLayout
                android:id="@+id/defaultCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_language_card"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_4"
                android:paddingBottom="@dimen/space_4" />

            <LinearLayout
                android:id="@+id/addButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/space_20"
                android:background="@drawable/bg_add_block_button"
                android:clickable="true"
                android:contentDescription="@string/add_response"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_add"
                    app:tint="@color/on_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:fontFamily="@font/roboto_medium"
                    android:importantForAccessibility="no"
                    android:text="@string/add_response"
                    android:textColor="@color/on_primary"
                    android:textSize="17sp"
                    app:fontFamily="@font/roboto_medium" />
            </LinearLayout>

            <TextView
                android:id="@+id/customEmptyHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:fontFamily="@font/roboto_regular"
                android:gravity="center"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"
                android:text="@string/empty_quick_body"
                android:textColor="@color/text_tertiary"
                android:textSize="14sp"
                app:fontFamily="@font/roboto_regular" />

            <LinearLayout
                android:id="@+id/customHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_4"
                android:paddingBottom="@dimen/space_8"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_medium"
                    android:text="@string/quick_my_responses"
                    android:textColor="@color/text_muted"
                    android:textSize="16sp"
                    app:fontFamily="@font/roboto_medium" />

                <TextView
                    android:id="@+id/customCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:background="@drawable/bg_search_count"
                    android:fontFamily="@font/roboto_medium"
                    android:gravity="center"
                    android:minWidth="22dp"
                    android:paddingStart="7dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="1dp"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    app:fontFamily="@font/roboto_medium" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/customCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_language_card"
                android:padding="1dp"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/customList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:paddingTop="@dimen/space_4"
                    android:paddingBottom="@dimen/space_4" />
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/nativeSmallContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
