<?xml version="1.0" encoding="utf-8"?>
<com.contacts.manager.ai.smartdialer.voicemessages.calling.callapp.ads.ui.ShimmerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background"
    android:importantForAccessibility="noHideDescendants"
    android:minHeight="56dp"
    android:tag="theme_ad_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_8">

        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_shimmer_circle" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_marginEnd="@dimen/space_8"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="140dp"
                android:layout_height="12dp"
                android:background="@drawable/bg_shimmer_block" />

            <View
                android:layout_width="100dp"
                android:layout_height="10dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_shimmer_block" />
        </LinearLayout>

        <View
            android:layout_width="72dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_shimmer_block" />
    </LinearLayout>
</com.contacts.manager.ai.smartdialer.voicemessages.calling.callapp.ads.ui.ShimmerLayout>
