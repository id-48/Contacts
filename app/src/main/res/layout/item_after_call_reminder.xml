<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_marginTop="@dimen/space_8"
    android:background="@drawable/bg_after_call_reminder"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_12"
    android:paddingEnd="@dimen/space_4">

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_notifications_filled"
        app:tint="@color/primary" />

    <TextView
        android:id="@+id/reminderTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_12"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/roboto_medium"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <ImageButton
        android:id="@+id/reminderDelete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_round_ripple"
        android:contentDescription="@string/delete"
        android:src="@drawable/ic_close"
        app:tint="@color/text_secondary" />
</LinearLayout>
