<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_12"
    android:background="@drawable/bg_selectable_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="76dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_16"
    android:paddingTop="@dimen/space_12"
    android:paddingEnd="@dimen/space_16"
    android:paddingBottom="@dimen/space_12"
    android:stateListAnimator="@animator/press_scale">

    <TextView
        android:id="@+id/languageFlag"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_circle_tint"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:textSize="26sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginEnd="@dimen/space_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/languageNative"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/roboto_bold"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            app:fontFamily="@font/roboto_bold" />

        <TextView
            android:id="@+id/languageEnglish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/roboto_regular"
            android:maxLines="1"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            app:fontFamily="@font/roboto_regular" />
    </LinearLayout>

    <ImageView
        android:id="@+id/languageCheck"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:background="@drawable/bg_option_check"
        android:importantForAccessibility="no"
        android:padding="5dp"
        android:src="@drawable/ic_check"
        app:tint="@color/on_primary" />
</LinearLayout>
