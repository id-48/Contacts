<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_24"
    android:paddingTop="28dp"
    android:paddingEnd="@dimen/space_24"
    android:paddingBottom="@dimen/space_24">

    <FrameLayout
        android:id="@+id/dialogIconContainer"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/space_16"
        android:background="@drawable/bg_circle_tint"
        android:visibility="gone">

        <ImageView
            android:id="@+id/dialogIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/primary" />
    </FrameLayout>

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:fontFamily="@font/roboto_bold"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        app:fontFamily="@font/roboto_bold" />

    <EditText
        android:id="@+id/responseField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_20"
        android:background="@null"
        android:fontFamily="@font/roboto_regular"
        android:gravity="top|start"
        android:hint="@string/quick_response_hint"
        android:imeOptions="actionDone|flagNoExtractUi"
        android:importantForAutofill="no"
        android:inputType="textCapSentences|textAutoCorrect"
        android:lineSpacingExtra="2dp"
        android:minHeight="52dp"
        android:paddingStart="2dp"
        android:paddingTop="@dimen/space_12"
        android:paddingEnd="2dp"
        android:paddingBottom="@dimen/space_12"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="18sp"
        app:fontFamily="@font/roboto_regular" />

    <View
        android:id="@+id/responseUnderline"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/responseError"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/roboto_regular"
            android:text="@string/quick_response_exists"
            android:textColor="@color/error"
            android:textSize="13sp"
            android:visibility="invisible"
            app:fontFamily="@font/roboto_regular" />

        <TextView
            android:id="@+id/responseCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:fontFamily="@font/roboto_regular"
            android:textColor="@color/text_tertiary"
            android:textSize="13sp"
            app:fontFamily="@font/roboto_regular" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cancelButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_button_neutral"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/roboto_medium"
            android:gravity="center"
            android:text="@string/cancel"
            android:textColor="@color/text_secondary"
            android:textSize="18sp"
            app:fontFamily="@font/roboto_medium" />

        <Space
            android:layout_width="@dimen/space_16"
            android:layout_height="0dp" />

        <TextView
            android:id="@+id/actionButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/roboto_medium"
            android:gravity="center"
            android:textColor="@color/on_primary"
            android:textSize="18sp"
            app:fontFamily="@font/roboto_medium" />
    </LinearLayout>
</LinearLayout>
