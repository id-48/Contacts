<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/screen_padding">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="@dimen/icon_button"
            android:layout_height="@dimen/icon_button"
            android:background="@drawable/bg_round_ripple"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_4"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:ellipsize="end"
            android:fontFamily="@font/roboto_bold"
            android:maxLines="1"
            android:text="@string/blocked_numbers"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            app:fontFamily="@font/roboto_bold" />
    </LinearLayout>

    <include
        android:id="@+id/banner"
        layout="@layout/include_banner"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/headerBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/space_12"
        android:paddingEnd="@dimen/screen_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_large"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_4"
            android:paddingBottom="@dimen/space_4">

            <com.contacts.manager.ai.smartdialer.voicemessages.calling.callapp.common.SettingRowView
                android:id="@+id/blockUnknownRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowIcon="@drawable/ic_block"
                app:rowShowSwitch="true"
                app:rowSubtitle="@string/block_unknown_subtitle"
                app:rowTitle="@string/block_unknown" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/addButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/bg_add_block_button"
            android:clickable="true"
            android:contentDescription="@string/add_a_number"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_person_add"
                app:tint="@color/on_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:fontFamily="@font/roboto_medium"
                android:importantForAccessibility="no"
                android:text="@string/add_a_number"
                android:textColor="@color/on_primary"
                android:textSize="17sp"
                app:fontFamily="@font/roboto_medium" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/listHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_4"
            android:paddingBottom="@dimen/space_8"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:text="@string/blocked_numbers"
                android:textColor="@color/text_muted"
                android:textSize="16sp"
                app:fontFamily="@font/roboto_medium" />

            <TextView
                android:id="@+id/listCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:background="@drawable/bg_search_count"
                android:fontFamily="@font/roboto_medium"
                android:gravity="center"
                android:minWidth="22dp"
                android:paddingStart="7dp"
                android:paddingTop="1dp"
                android:paddingEnd="7dp"
                android:paddingBottom="1dp"
                android:textColor="@color/primary"
                android:textSize="12sp"
                app:fontFamily="@font/roboto_medium" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/listCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginEnd="@dimen/screen_padding"
            android:layout_marginBottom="@dimen/space_16"
            android:background="@drawable/bg_language_card"
            android:padding="1dp"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:paddingTop="@dimen/space_4"
                android:paddingBottom="@dimen/space_4" />
        </FrameLayout>

        <com.contacts.manager.ai.smartdialer.voicemessages.calling.callapp.common.EmptyStateView
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
