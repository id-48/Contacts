<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/infoRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row"
    android:gravity="center_vertical"
    android:minHeight="68dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_16"
    android:paddingTop="@dimen/space_8"
    android:paddingEnd="@dimen/space_8"
    android:paddingBottom="@dimen/space_8">

    <ImageView
        android:id="@+id/infoIcon"
        android:layout_width="@dimen/icon_size"
        android:layout_height="@dimen/icon_size"
        android:importantForAccessibility="no"
        app:tint="@color/text_secondary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_20"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/infoValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/infoLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.App.BodySmall"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        tools:ignore="ContentDescription"
        android:id="@+id/infoActionFirst"
        android:layout_width="@dimen/icon_button"
        android:layout_height="@dimen/icon_button"
        android:background="@drawable/bg_round_ripple"
        android:visibility="gone"
        app:tint="@color/text_primary" />

    <ImageButton
        tools:ignore="ContentDescription"
        android:id="@+id/infoActionSecond"
        android:layout_width="@dimen/icon_button"
        android:layout_height="@dimen/icon_button"
        android:background="@drawable/bg_round_ripple"
        android:visibility="gone"
        app:tint="@color/text_primary" />
</LinearLayout>
