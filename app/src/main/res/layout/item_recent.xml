<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recentCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/space_8"
    android:layout_marginTop="2dp"
    android:layout_marginEnd="@dimen/space_8"
    android:layout_marginBottom="2dp"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/recentRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_row"
        android:gravity="center_vertical"
        android:minHeight="@dimen/row_min_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_12"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/space_8"
        android:paddingBottom="@dimen/space_8">

        <com.contacts.manager.ai.smartdialer.voicemessages.calling.callapp.common.ContactAvatarView
            android:id="@+id/recentAvatar"
            android:layout_width="@dimen/avatar_medium"
            android:layout_height="@dimen/avatar_medium" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_16"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/recentName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/roboto_medium"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                app:fontFamily="@font/roboto_medium" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:id="@+id/recentTypeIcon"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginEnd="@dimen/space_4"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/recentSubtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/roboto_regular"
                    android:maxLines="1"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp"
                    app:fontFamily="@font/roboto_regular" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/recentCall"
            tools:ignore="ContentDescription"
            android:layout_width="@dimen/icon_button"
            android:layout_height="@dimen/icon_button"
            android:background="@drawable/bg_round_ripple"
            android:src="@drawable/ic_call"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/recentActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_4"
        android:paddingBottom="@dimen/space_8"
        android:visibility="gone">

        <include
            android:id="@+id/actionFirst"
            layout="@layout/include_row_action" />

        <include
            android:id="@+id/actionSecond"
            layout="@layout/include_row_action" />

        <include
            android:id="@+id/actionThird"
            layout="@layout/include_row_action" />
    </LinearLayout>
</LinearLayout>
