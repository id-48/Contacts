<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <include
        android:id="@+id/topBar"
        layout="@layout/include_top_bar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_24">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                app:checkedButton="@id/importTab"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/importTab"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="@string/import_tab"
                    android:textColor="@color/selector_segment_text"
                    app:backgroundTint="@color/selector_segment_bg"
                    app:strokeColor="@color/divider" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/exportTab"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="@string/export_tab"
                    android:textColor="@color/selector_segment_text"
                    app:backgroundTint="@color/selector_segment_bg"
                    app:strokeColor="@color/divider" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <LinearLayout
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/bg_settings_group"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/space_24">

                <ImageView
                    android:id="@+id/heroIcon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_circle_tint"
                    android:importantForAccessibility="no"
                    android:padding="18dp"
                    android:src="@drawable/ic_file"
                    app:tint="@color/primary" />

                <TextView
                    android:id="@+id/heroBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/fileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:background="@drawable/bg_value_chip"
                    android:drawablePadding="@dimen/space_8"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:paddingStart="@dimen/space_12"
                    android:paddingTop="@dimen/space_8"
                    android:paddingEnd="@dimen/space_12"
                    android:paddingBottom="@dimen/space_8"
                    android:textAppearance="@style/TextAppearance.App.BodySmall"
                    android:textColor="@color/on_primary_container"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_file"
                    app:drawableTint="@color/primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chooseFile"
                    style="@style/Widget.App.Button.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:text="@string/import_choose"
                    app:icon="@drawable/ic_file" />
            </LinearLayout>

            <TextView
                android:id="@+id/accountTitle"
                style="@style/Widget.App.SettingsSection" />

            <LinearLayout
                android:id="@+id/accountGroup"
                style="@style/Widget.App.SettingsGroup" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:indeterminate="true"
                android:visibility="gone"
                app:trackCornerRadius="4dp" />

            <include
                android:id="@+id/ads"
                layout="@layout/include_native_ads"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_12">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/actionButton"
            style="@style/Widget.App.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
