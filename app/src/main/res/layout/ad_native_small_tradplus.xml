<?xml version="1.0" encoding="utf-8"?>
<!-- TradPlus renders into the tp_* ids; keep them even when a view is hidden. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="82dp"
    android:background="@color/ad_small_background">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <FrameLayout
                android:id="@+id/tp_native_main_image"
                android:layout_width="130dp"
                android:layout_height="80dp"
                android:layout_weight="0.1">

                <ImageView
                    android:id="@+id/tp_native_icon_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/tp_mopub_native_main_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tp_native_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/ad_small_title"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tp_native_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/ad_small_body"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tp_native_advertiser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/ad_small_body"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </LinearLayout>

            <Button
                android:id="@+id/tp_native_cta_btn"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_btn_create_pill"
                android:elevation="0dp"
                android:minWidth="72dp"
                android:minHeight="0dp"
                android:paddingHorizontal="14dp"
                android:stateListAnimator="@null"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                tools:ignore="SmallSp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_ad_text"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:text="@string/ad_badge"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="8sp"
            android:textStyle="bold"
            tools:ignore="SmallSp" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/tp_ad_choices_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="@dimen/space_2" />

    <LinearLayout
        android:id="@+id/tp_layout_ad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/tp_native_ad_choice"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:visibility="gone" />
</RelativeLayout>
