<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_12">

            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_4">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/appIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/ic_launcher"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Icon" />

                <TextView
                    android:id="@+id/appName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/roboto_medium"
                    android:maxLines="1"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/closeButton"
                    android:layout_width="@dimen/icon_button"
                    android:layout_height="@dimen/icon_button"
                    android:background="@drawable/bg_round_ripple"
                    android:contentDescription="@string/close"
                    android:src="@drawable/ic_close"
                    app:tint="@color/text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/headerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_marginEnd="@dimen/space_12"
                android:background="@drawable/bg_after_call_header"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_after_call_avatar_ring"
                    android:padding="2dp">

                    <com.contacts.manager.ai.smartdialer.voicemessages.calling.callapp.common.ContactAvatarView
                        android:id="@+id/avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_marginEnd="@dimen/space_8"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/nameText"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/roboto_bold"
                        android:gravity="center_vertical|start"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        app:autoSizeMaxTextSize="18sp"
                        app:autoSizeMinTextSize="14sp"
                        app:autoSizeTextType="uniform" />

                    <TextView
                        android:id="@+id/numberText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/typeIcon"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="@dimen/space_4"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/detailText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/callBackButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_answer"
                    android:clickable="true"
                    android:contentDescription="@string/call_back"
                    android:focusable="true"
                    android:foreground="@drawable/bg_round_ripple"
                    android:stateListAnimator="@animator/press_scale">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_call_filled"
                        app:tint="@color/white" />
                </FrameLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/tabBar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/space_12"
                android:layout_marginTop="@dimen/space_12"
                android:layout_marginEnd="@dimen/space_12"
                android:background="@drawable/bg_after_call_tabs"
                android:padding="@dimen/space_4">

                <View
                    android:id="@+id/tabPill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_after_call_tab_pill" />

                <LinearLayout
                    android:id="@+id/tabs"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/tabActions"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:contentDescription="@string/after_call_tab_contact"
                        android:scaleType="center"
                        android:src="@drawable/ic_person_filled"
                        app:tint="@color/selector_after_call_tab" />

                    <ImageView
                        android:id="@+id/tabMessages"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:contentDescription="@string/after_call_messages"
                        android:scaleType="center"
                        android:src="@drawable/ic_chat_filled"
                        app:tint="@color/selector_after_call_tab" />

                    <ImageView
                        android:id="@+id/tabReminders"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:contentDescription="@string/reminders"
                        android:scaleType="center"
                        android:src="@drawable/ic_notifications_filled"
                        app:tint="@color/selector_after_call_tab" />

                    <ImageView
                        android:id="@+id/tabMore"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:contentDescription="@string/more"
                        android:scaleType="center"
                        android:src="@drawable/ic_more_horiz"
                        app:tint="@color/selector_after_call_tab" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/pages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:paddingStart="@dimen/space_12"
                android:paddingEnd="@dimen/space_12">

                <LinearLayout
                    android:id="@+id/pageActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/pageMessages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="invisible">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/messageChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="@dimen/space_8"
                        app:chipSpacingVertical="@dimen/space_8" />

                    <LinearLayout
                        android:id="@+id/personalMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_after_call_input"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_16"
                        android:paddingEnd="6dp">

                        <EditText
                            android:id="@+id/personalMessageField"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/after_call_personal_message"
                            android:imeOptions="actionSend"
                            android:importantForAutofill="no"
                            android:inputType="textCapSentences"
                            android:maxLines="1"
                            android:paddingTop="@dimen/space_8"
                            android:paddingBottom="@dimen/space_8"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_tertiary"
                            android:textSize="15sp" />

                        <ImageButton
                            android:id="@+id/personalMessageSend"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="@dimen/space_8"
                            android:background="@drawable/bg_circle_primary"
                            android:contentDescription="@string/send_message"
                            android:src="@drawable/ic_send"
                            android:stateListAnimator="@animator/press_scale"
                            android:visibility="invisible"
                            app:tint="@color/on_primary" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/pageReminders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="invisible">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/reminderChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="@dimen/space_8"
                        app:chipSpacingVertical="@dimen/space_8" />

                    <TextView
                        android:id="@+id/reminderEmpty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:drawablePadding="@dimen/space_8"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/space_4"
                        android:paddingEnd="@dimen/space_4"
                        android:text="@string/reminder_empty"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        app:drawableStartCompat="@drawable/ic_notifications_filled"
                        app:drawableTint="@color/text_tertiary" />

                    <LinearLayout
                        android:id="@+id/reminderRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/pageMore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="invisible" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/adContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_marginTop="@dimen/space_12"
                android:layout_marginEnd="@dimen/space_12"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/nativeBigContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
