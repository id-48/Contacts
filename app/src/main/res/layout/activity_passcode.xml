<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <include
        android:id="@+id/topBar"
        layout="@layout/include_top_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/onboarding_padding"
        android:paddingEnd="@dimen/onboarding_padding">

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/lockBadge"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:background="@drawable/bg_circle_tint">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_lock"
                app:tint="@color/primary" />
        </FrameLayout>

        <TextView
            android:id="@+id/passcodeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.App.Headline" />

        <TextView
            android:id="@+id/passcodeBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.App.BodySecondary" />

        <LinearLayout
            android:id="@+id/dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/passcodeError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:minHeight="20dp"
            android:textAppearance="@style/TextAppearance.App.BodySmall"
            android:textColor="@color/error" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/keypad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/forgotButton"
            style="@style/Widget.App.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/passcode_forgot"
            android:textColor="@color/primary"
            android:visibility="gone" />
    </LinearLayout>

    <include
        android:id="@+id/ads"
        layout="@layout/include_native_ads"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
