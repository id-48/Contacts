<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <FrameLayout
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/bg_circle_tint">

        <ImageView
            android:id="@+id/emptyIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/primary" />
    </FrameLayout>

    <TextView
        android:id="@+id/emptyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_20"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.App.Title" />

    <TextView
        android:id="@+id/emptyBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:gravity="center"
        android:maxWidth="300dp"
        android:textAppearance="@style/TextAppearance.App.BodySecondary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/emptyAction"
        style="@style/Widget.App.Button.Tonal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:minHeight="48dp"
        android:paddingStart="@dimen/space_24"
        android:paddingEnd="@dimen/space_24"
        android:textColor="@color/primary"
        android:visibility="gone" />
</merge>
