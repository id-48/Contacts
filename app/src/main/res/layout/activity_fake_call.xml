<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <include
        android:id="@+id/topBar"
        layout="@layout/include_top_bar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding"
                android:paddingBottom="96dp">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/tabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    app:checkedButton="@id/upcomingTab"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/upcomingTab"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="@string/fake_call_upcoming"
                        android:textColor="@color/selector_segment_text"
                        app:backgroundTint="@color/selector_segment_bg"
                        app:strokeColor="@color/divider" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/completedTab"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="@string/fake_call_completed"
                        android:textColor="@color/selector_segment_text"
                        app:backgroundTint="@color/selector_segment_bg"
                        app:strokeColor="@color/divider" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <LinearLayout
                    android:id="@+id/listGroup"
                    style="@style/Widget.App.SettingsGroup"
                    android:layout_marginTop="@dimen/space_16" />

                <com.contacts.manager.ai.smartdialer.voicemessages.calling.callapp.common.EmptyStateView
                    android:id="@+id/emptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/space_32"
                    android:paddingBottom="@dimen/space_16"
                    android:visibility="gone" />

                <include
                    android:id="@+id/ads"
                    layout="@layout/include_native_ads"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/scheduleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/space_20"
            android:text="@string/fake_call_schedule"
            android:textColor="@color/on_primary"
            app:backgroundTint="@color/primary"
            app:icon="@drawable/ic_add"
            app:iconTint="@color/on_primary" />
    </FrameLayout>
</LinearLayout>
