<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/optionCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_12"
    android:background="@drawable/bg_selectable_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="84dp"
    android:orientation="horizontal"
    android:padding="@dimen/space_16"
    android:stateListAnimator="@animator/press_scale">

    <ImageView
        android:id="@+id/optionIcon"
        android:layout_width="@dimen/setting_icon_chip"
        android:layout_height="@dimen/setting_icon_chip"
        android:background="@drawable/bg_setting_icon"
        android:backgroundTint="@color/primary_container"
        android:importantForAccessibility="no"
        android:padding="@dimen/space_8"
        app:tint="@color/primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginEnd="@dimen/space_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/optionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.App.TitleSmall" />

        <TextView
            android:id="@+id/optionBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.App.BodySmall"
            android:textColor="@color/text_secondary" />

        <LinearLayout
            android:id="@+id/optionPreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/optionCheck"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/bg_option_check"
        android:importantForAccessibility="no"
        android:padding="4dp"
        android:src="@drawable/ic_check"
        app:tint="@color/on_primary" />
</LinearLayout>
