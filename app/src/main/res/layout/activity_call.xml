<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/call_screen_dim"
        android:visibility="gone" />

<LinearLayout
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/secondaryBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginEnd="@dimen/screen_padding"
        android:background="@drawable/bg_tile"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_16"
        android:paddingEnd="@dimen/space_8"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/icon_small"
            android:layout_height="@dimen/icon_small"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_pause"
            app:tint="@color/text_secondary" />

        <TextView
            android:id="@+id/secondaryText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.BodySmall"
            android:textColor="@color/text_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/secondarySwap"
            style="@style/Widget.App.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/swap" />
    </LinearLayout>

    <TextView
        android:id="@+id/callTimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:fontFamily="@font/roboto_medium"
        android:gravity="center"
        android:minHeight="28dp"
        android:textColor="@color/text_primary"
        android:textSize="20sp" />

    <LinearLayout
        android:id="@+id/identityBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/onboarding_padding"
        android:paddingEnd="@dimen/onboarding_padding">

        <com.contacts.manager.ai.smartdialer.voicemessages.calling.callapp.common.ContactAvatarView
            android:id="@+id/avatar"
            android:layout_width="128dp"
            android:layout_height="128dp" />

        <TextView
            android:id="@+id/callName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.App.Headline"
            android:textSize="@dimen/text_display" />

        <TextView
            android:id="@+id/callNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/callStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:textColor="@color/primary" />

        <TextView
            android:id="@+id/spamWarning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:background="@drawable/bg_spam_chip"
            android:drawablePadding="@dimen/space_8"
            android:fontFamily="@font/roboto_medium"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/space_12"
            android:paddingTop="6dp"
            android:paddingEnd="@dimen/space_16"
            android:paddingBottom="6dp"
            android:text="@string/possible_spam"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_warning"
            app:drawableTint="@color/white" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/keypadPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/dtmfDigits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:ellipsize="start"
                android:fontFamily="@font/roboto_medium"
                android:gravity="center"
                android:maxLines="1"
                android:minHeight="40dp"
                android:paddingStart="@dimen/onboarding_padding"
                android:paddingEnd="@dimen/onboarding_padding"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_dial_number" />

            <com.contacts.manager.ai.smartdialer.voicemessages.calling.callapp.common.DialPadView
                android:id="@+id/dialPad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/moreCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginEnd="@dimen/screen_padding"
            android:layout_marginBottom="@dimen/space_8"
            android:background="@drawable/bg_call_more_card"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_8"
            android:paddingTop="@dimen/space_20"
            android:paddingEnd="@dimen/space_8"
            android:paddingBottom="@dimen/space_16"
            android:visibility="gone">

            <include
                android:id="@+id/holdControl"
                layout="@layout/include_call_option" />

            <include
                android:id="@+id/addCallControl"
                layout="@layout/include_call_option" />

            <include
                android:id="@+id/swapControl"
                layout="@layout/include_call_option" />

            <include
                android:id="@+id/mergeControl"
                layout="@layout/include_call_option" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/activePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_8"
        android:paddingEnd="@dimen/space_8">

        <include
            android:id="@+id/muteControl"
            layout="@layout/include_call_control" />

        <include
            android:id="@+id/keypadControl"
            layout="@layout/include_call_control" />

        <include
            android:id="@+id/speakerControl"
            layout="@layout/include_call_control" />

        <include
            android:id="@+id/moreControl"
            layout="@layout/include_call_control" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:layout_marginBottom="@dimen/space_32">

        <ImageButton
            android:id="@+id/endButton"
            android:layout_width="@dimen/call_button_size"
            android:layout_height="@dimen/call_button_size"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle_decline"
            android:contentDescription="@string/end_call"
            android:src="@drawable/ic_call_end_filled"
            android:stateListAnimator="@animator/press_scale"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/hideKeypadButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="@dimen/space_24"
            android:background="@drawable/bg_row"
            android:fontFamily="@font/roboto_medium"
            android:gravity="center"
            android:maxWidth="120dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingStart="@dimen/space_16"
            android:paddingEnd="@dimen/space_16"
            android:text="@string/hide_keypad"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/incomingPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/messageButton"
                style="@style/Widget.App.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginBottom="@dimen/space_40"
                android:backgroundTint="@color/surface_elevated"
                android:elevation="4dp"
                android:paddingStart="@dimen/space_24"
                android:paddingEnd="@dimen/space_24"
                android:text="@string/message"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                app:icon="@drawable/ic_chat"
                app:iconTint="@color/text_primary"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp" />

            <com.contacts.manager.ai.smartdialer.voicemessages.calling.callapp.screens.call.IncomingCallControlView
                android:id="@+id/incomingControl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/nativeSmallContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
</FrameLayout>
