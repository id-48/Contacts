<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/languageToolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/screen_padding">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="@dimen/icon_button"
            android:layout_height="@dimen/icon_button"
            android:background="@drawable/bg_round_ripple"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/languageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_4"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:ellipsize="end"
            android:fontFamily="@font/roboto_bold"
            android:maxLines="1"
            android:text="@string/choose_language"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            app:fontFamily="@font/roboto_bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/doneButton"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:fontFamily="@font/roboto_medium"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="88dp"
            android:paddingStart="@dimen/space_20"
            android:paddingEnd="@dimen/space_20"
            android:text="@string/done"
            android:textAllCaps="false"
            android:textColor="@color/on_primary"
            android:textSize="17sp"
            app:backgroundTint="@color/primary"
            app:cornerRadius="100dp"
            app:fontFamily="@font/roboto_medium" />
    </LinearLayout>

    <TextView
        android:id="@+id/languageSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_regular"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_12"
        android:text="@string/language_subtitle"
        android:textColor="@color/text_muted"
        android:textSize="15sp"
        android:visibility="gone"
        app:fontFamily="@font/roboto_regular" />

    <FrameLayout
        android:id="@+id/languageCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginBottom="@dimen/space_16"
        android:layout_weight="1"
        android:background="@drawable/bg_language_card"
        android:padding="1dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/languageList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingTop="@dimen/space_4"
            android:paddingBottom="@dimen/space_4"
            android:scrollbars="none" />
    </FrameLayout>
</LinearLayout>
