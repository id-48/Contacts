<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_12">

        <ImageButton
            android:id="@+id/closeButton"
            android:layout_width="@dimen/icon_button"
            android:layout_height="@dimen/icon_button"
            android:background="@drawable/bg_round_ripple"
            android:contentDescription="@string/cancel"
            android:src="@drawable/ic_close"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/editTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.Title"
            android:textSize="22sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/doneButton"
            style="@style/Widget.App.Button.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/done" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_32">

            <LinearLayout
                android:id="@+id/formContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding">

                <FrameLayout
                    android:id="@+id/photoContainer"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_8"
                    android:clickable="true"
                    android:contentDescription="@string/set_photo"
                    android:focusable="true">

                    <com.contacts.manager.ai.smartdialer.voicemessages.calling.callapp.common.ContactAvatarView
                        android:id="@+id/photoView"
                        android:layout_width="@dimen/avatar_hero"
                        android:layout_height="@dimen/avatar_hero"
                        android:layout_gravity="center" />

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_circle_primary"
                        android:elevation="2dp">

                        <ImageView
                            android:id="@+id/photoBadge"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_photo_camera"
                            app:tint="@color/on_primary" />
                    </FrameLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/accountSelector"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_8"
                    android:background="@drawable/bg_row"
                    android:drawablePadding="@dimen/space_4"
                    android:fontFamily="@font/roboto_medium"
                    android:gravity="center"
                    android:paddingStart="@dimen/space_12"
                    android:paddingEnd="@dimen/space_8"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    app:drawableEndCompat="@drawable/ic_expand_more"
                    app:drawableTint="@color/text_primary" />

                <LinearLayout
                    android:id="@+id/nameCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:background="@drawable/bg_card_large"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="56dp"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_16"
                        android:paddingEnd="@dimen/space_4">

                        <ImageView
                            android:layout_width="@dimen/icon_size"
                            android:layout_height="@dimen/icon_size"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_person"
                            app:tint="@color/text_primary" />

                        <EditText
                            android:id="@+id/firstNameField"
                            style="@style/Widget.App.FormInput"
                            android:layout_width="0dp"
                            android:layout_marginStart="@dimen/space_16"
                            android:layout_weight="1"
                            android:autofillHints="personGivenName"
                            android:hint="@string/first_name"
                            android:inputType="textPersonName|textCapWords" />

                        <ImageButton
                            android:id="@+id/nameExpandButton"
                            android:layout_width="@dimen/icon_button"
                            android:layout_height="@dimen/icon_button"
                            android:background="@drawable/bg_round_ripple"
                            android:contentDescription="@string/more_name_fields"
                            android:src="@drawable/ic_expand_more"
                            app:tint="@color/text_primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/nameExtra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <View style="@style/Widget.App.FormDivider" />

                        <EditText
                            android:id="@+id/middleNameField"
                            style="@style/Widget.App.FormInput.Indented"
                            android:autofillHints="personMiddleName"
                            android:hint="@string/middle_name"
                            android:inputType="textPersonName|textCapWords" />

                        <View style="@style/Widget.App.FormDivider" />

                        <EditText
                            android:id="@+id/lastNameField"
                            style="@style/Widget.App.FormInput.Indented"
                            android:autofillHints="personFamilyName"
                            android:hint="@string/surname"
                            android:inputType="textPersonName|textCapWords" />

                        <View style="@style/Widget.App.FormDivider" />

                        <EditText
                            android:id="@+id/prefixField"
                            style="@style/Widget.App.FormInput.Indented"
                            android:autofillHints="personNamePrefix"
                            android:hint="@string/prefix"
                            android:inputType="textPersonName|textCapWords" />

                        <View style="@style/Widget.App.FormDivider" />

                        <EditText
                            android:id="@+id/suffixField"
                            style="@style/Widget.App.FormInput.Indented"
                            android:autofillHints="personNameSuffix"
                            android:hint="@string/suffix"
                            android:inputType="textPersonName|textCapWords" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:background="@drawable/bg_card_large"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="56dp"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_16"
                        android:paddingEnd="@dimen/space_16">

                        <ImageView
                            android:layout_width="@dimen/icon_size"
                            android:layout_height="@dimen/icon_size"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_apartment"
                            app:tint="@color/text_primary" />

                        <EditText
                            android:id="@+id/companyField"
                            style="@style/Widget.App.FormInput"
                            android:layout_width="0dp"
                            android:layout_marginStart="@dimen/space_16"
                            android:layout_weight="1"
                            android:hint="@string/company"
                            android:importantForAutofill="no"
                            android:inputType="textCapWords" />
                    </LinearLayout>

                    <View style="@style/Widget.App.FormDivider" />

                    <EditText
                        android:id="@+id/jobTitleField"
                        style="@style/Widget.App.FormInput.Indented"
                        android:hint="@string/job_title"
                        android:importantForAutofill="no"
                        android:inputType="textCapWords" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:animateLayoutChanges="true"
                    android:background="@drawable/bg_card_large"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/phoneRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:animateLayoutChanges="true"
                        android:orientation="vertical" />

                    <include
                        android:id="@+id/addPhone"
                        layout="@layout/include_add_row" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:animateLayoutChanges="true"
                    android:background="@drawable/bg_card_large"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/emailRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:animateLayoutChanges="true"
                        android:orientation="vertical" />

                    <include
                        android:id="@+id/addEmail"
                        layout="@layout/include_add_row" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:background="@drawable/bg_card_large"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/addAddress"
                        layout="@layout/include_add_row" />

                    <LinearLayout
                        android:id="@+id/addressRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="56dp"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_16"
                        android:paddingEnd="@dimen/space_4"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="@dimen/icon_size"
                            android:layout_height="@dimen/icon_size"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_location_on"
                            app:tint="@color/text_primary" />

                        <EditText
                            android:id="@+id/addressField"
                            style="@style/Widget.App.FormInput"
                            android:layout_width="0dp"
                            android:layout_marginStart="@dimen/space_16"
                            android:layout_weight="1"
                            android:autofillHints="postalAddress"
                            android:hint="@string/address"
                            android:inputType="textPostalAddress|textMultiLine|textCapWords" />

                        <ImageButton
                            android:id="@+id/removeAddress"
                            android:layout_width="@dimen/icon_button"
                            android:layout_height="@dimen/icon_button"
                            android:background="@drawable/bg_round_ripple"
                            android:contentDescription="@string/remove"
                            android:src="@drawable/ic_do_not_disturb_on"
                            app:tint="@color/error" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:background="@drawable/bg_card_large"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/addBirthday"
                        layout="@layout/include_add_row" />

                    <LinearLayout
                        android:id="@+id/birthdayRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_row"
                        android:gravity="center_vertical"
                        android:minHeight="56dp"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_16"
                        android:paddingEnd="@dimen/space_4"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="@dimen/icon_size"
                            android:layout_height="@dimen/icon_size"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_cake"
                            app:tint="@color/text_primary" />

                        <TextView
                            android:id="@+id/birthdayValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_16"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textSize="16sp" />

                        <ImageButton
                            android:id="@+id/removeBirthday"
                            android:layout_width="@dimen/icon_button"
                            android:layout_height="@dimen/icon_button"
                            android:background="@drawable/bg_round_ripple"
                            android:contentDescription="@string/remove"
                            android:src="@drawable/ic_do_not_disturb_on"
                            app:tint="@color/error" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:background="@drawable/bg_card_large"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_16"
                    android:paddingEnd="@dimen/space_16">

                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_badge"
                        app:tint="@color/text_primary" />

                    <EditText
                        android:id="@+id/nicknameField"
                        style="@style/Widget.App.FormInput"
                        android:layout_width="0dp"
                        android:layout_marginStart="@dimen/space_16"
                        android:layout_weight="1"
                        android:hint="@string/nickname"
                        android:importantForAutofill="no"
                        android:inputType="textPersonName|textCapWords" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:background="@drawable/bg_card_large"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_16"
                    android:paddingEnd="@dimen/space_16">

                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_sticky_note_2"
                        app:tint="@color/text_primary" />

                    <EditText
                        android:id="@+id/notesField"
                        style="@style/Widget.App.FormInput"
                        android:layout_width="0dp"
                        android:layout_marginStart="@dimen/space_16"
                        android:layout_weight="1"
                        android:hint="@string/notes"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine|textCapSentences"
                        android:paddingTop="@dimen/space_12"
                        android:paddingBottom="@dimen/space_12" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
