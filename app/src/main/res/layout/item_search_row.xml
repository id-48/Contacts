<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/searchRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/space_8"
    android:layout_marginEnd="@dimen/space_8"
    android:background="@drawable/bg_row"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_12"
    android:paddingTop="@dimen/space_8"
    android:paddingEnd="@dimen/space_8"
    android:paddingBottom="@dimen/space_8">

    <com.contacts.manager.ai.smartdialer.voicemessages.calling.callapp.common.ContactAvatarView
        android:id="@+id/rowAvatar"
        android:layout_width="@dimen/avatar_medium"
        android:layout_height="@dimen/avatar_medium" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_16"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/roboto_medium"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            app:fontFamily="@font/roboto_medium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/rowTypeIcon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginEnd="@dimen/space_4"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <TextView
                android:id="@+id/rowSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/roboto_regular"
                android:maxLines="1"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                app:fontFamily="@font/roboto_regular" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/rowCall"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="@dimen/space_8"
        android:layout_marginEnd="@dimen/space_4"
        android:background="@drawable/bg_search_call"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_call_filled"
        app:tint="@color/primary" />
</LinearLayout>
