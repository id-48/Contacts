<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/space_8"
    android:layout_marginEnd="@dimen/space_8"
    android:background="@drawable/bg_row"
    android:gravity="center_vertical"
    android:minHeight="@dimen/row_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_12"
    android:paddingTop="@dimen/space_8"
    android:paddingEnd="@dimen/space_8"
    android:paddingBottom="@dimen/space_8">

    <com.contacts.manager.ai.smartdialer.voicemessages.calling.callapp.common.ContactAvatarView
        android:id="@+id/personAvatar"
        android:layout_width="@dimen/avatar_medium"
        android:layout_height="@dimen/avatar_medium" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_16"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/personName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.TitleSmall" />

        <TextView
            android:id="@+id/personSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.BodySmall"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        tools:ignore="ContentDescription"
        android:id="@+id/personAction"
        android:layout_width="@dimen/icon_button"
        android:layout_height="@dimen/icon_button"
        android:background="@drawable/bg_round_ripple"
        android:src="@drawable/ic_call"
        android:visibility="gone"
        app:tint="@color/primary" />
</LinearLayout>
