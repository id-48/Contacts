<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_8"
    android:paddingBottom="@dimen/space_8">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/space_12"
        android:background="@drawable/bg_pill_track" />

    <TextView
        android:id="@+id/pickTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_bold"
        android:paddingStart="@dimen/space_24"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/space_24"
        android:paddingBottom="@dimen/space_12"
        android:text="@string/add_favorite"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        app:fontFamily="@font/roboto_bold" />

    <LinearLayout
        android:id="@+id/pickSearchBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginEnd="@dimen/space_16"
        android:layout_marginBottom="@dimen/space_8"
        android:background="@drawable/bg_search_field_state"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_16"
        android:paddingEnd="@dimen/space_4">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_search"
            app:tint="@color/text_secondary" />

        <EditText
            android:id="@+id/pickSearchField"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/space_12"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="@font/roboto_regular"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textCursorDrawable="@null"
            android:textSize="16sp"
            app:fontFamily="@font/roboto_regular" />

        <ImageButton
            android:id="@+id/pickSearchClear"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_round_ripple"
            android:contentDescription="@string/clear"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/pickListContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pickList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="@dimen/space_8" />

        <TextView
            android:id="@+id/pickEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/roboto_regular"
            android:gravity="center"
            android:padding="@dimen/space_24"
            android:text="@string/search_empty_title"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:visibility="gone"
            app:fontFamily="@font/roboto_regular" />
    </FrameLayout>
</LinearLayout>
