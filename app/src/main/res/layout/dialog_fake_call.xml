<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/dialogCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_card"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingTop="28dp"
        android:paddingEnd="@dimen/space_24"
        android:paddingBottom="@dimen/space_24">

        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:fontFamily="@font/roboto_bold"
            android:gravity="center"
            android:text="@string/fake_call_schedule"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            app:fontFamily="@font/roboto_bold" />

        <EditText
            android:id="@+id/nameField"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/space_20"
            android:background="@null"
            android:fontFamily="@font/roboto_regular"
            android:hint="@string/fake_call_name"
            android:imeOptions="actionNext|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="40"
            android:maxLines="1"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="18sp"
            app:fontFamily="@font/roboto_regular" />

        <View
            android:id="@+id/nameUnderline"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <TextView
            android:id="@+id/nameError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:fontFamily="@font/roboto_regular"
            android:text="@string/fake_call_name_required"
            android:textColor="@color/error"
            android:textSize="13sp"
            android:visibility="gone"
            app:fontFamily="@font/roboto_regular" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/space_12"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/numberField"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:digits="0123456789+*#-() "
                android:fontFamily="@font/roboto_regular"
                android:hint="@string/fake_call_number"
                android:imeOptions="actionDone|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="phone"
                android:maxLength="20"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="18sp"
                app:fontFamily="@font/roboto_regular" />

            <ImageButton
                android:id="@+id/pickContact"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_round_ripple"
                android:contentDescription="@string/fake_call_pick_contact"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_contacts"
                app:tint="@color/primary" />
        </LinearLayout>

        <View
            android:id="@+id/numberUnderline"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:fontFamily="@font/roboto_medium"
            android:text="@string/fake_call_time"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:fontFamily="@font/roboto_medium" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/timeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            app:chipSpacingVertical="0dp"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:fontFamily="@font/roboto_medium"
            android:text="@string/fake_call_duration"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:fontFamily="@font/roboto_medium" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/durationGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            app:chipSpacingVertical="0dp"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cancelButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dialog_button_neutral"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/roboto_medium"
                android:gravity="center"
                android:text="@string/cancel"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                app:fontFamily="@font/roboto_medium" />

            <Space
                android:layout_width="@dimen/space_16"
                android:layout_height="0dp" />

            <TextView
                android:id="@+id/scheduleButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dialog_button_primary"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/roboto_medium"
                android:gravity="center"
                android:text="@string/schedule"
                android:textColor="@color/on_primary"
                android:textSize="18sp"
                app:fontFamily="@font/roboto_medium" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
