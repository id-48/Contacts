<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/card_strong">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="@color/primary_container" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/primary" />
                    <corners android:radius="@dimen/radius_20" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/surface_card" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/surface_stroke" />
                    <corners android:radius="@dimen/radius_20" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
