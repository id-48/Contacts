    <string name="default_app_body">Đặt làm mặc định để mở khóa các tính năng gọi điện và danh bạ nâng cao.</string>
    <string name="default_required_title">Cần đặt làm ứng dụng mặc định</string>
    <string name="default_required_body">Đặt ứng dụng này làm ứng dụng điện thoại mặc định để tiếp tục. Cuộc gọi, danh bạ và chặn cuộc gọi chỉ hoạt động khi ứng dụng là mặc định.</string>
    <string name="default_required_settings_body">Mở Cài đặt, đi tới Ứng dụng mặc định &gt; Ứng dụng điện thoại và chọn ứng dụng này để tiếp tục.</string>
    <string name="perm_sheet_call_history_title">Lịch sử cuộc gọi</string>
    <string name="perm_sheet_call_history_body">Dữ liệu cuộc gọi cần thiết giúp hiển thị lịch sử và quản lý cuộc gọi hiệu quả.</string>
    <string name="perm_sheet_contacts_title">Truy cập danh bạ</string>
    <string name="perm_sheet_contacts_body">Truy cập danh bạ để hỗ trợ mục yêu thích và gọi nhanh, đồng thời bảo vệ quyền riêng tư dữ liệu.</string>
    <string name="perm_sheet_overlay_title">Hiển thị nổi</string>
    <string name="perm_sheet_overlay_body">Bật quyền hiển thị trên ứng dụng khác để các tính năng hoạt động chính xác.</string>
    <string name="perm_required_title">Cần cấp quyền</string>
    <string name="perm_required_settings_body">Ứng dụng cần quyền %1$s để hoạt động. Mở Cài đặt, chạm vào Quyền và cho phép để tiếp tục.</string>
    <string name="perm_required_overlay_body">Cho phép \"Hiển thị trên ứng dụng khác\" cho ứng dụng này để tiếp tục. Quyền này cần thiết để các tính năng cuộc gọi hoạt động chính xác.</string>
    <string name="open_settings">Mở cài đặt</string>
    <string name="about_no_ads">Miễn phí kèm quảng cáo</string>
    <string name="about_no_ads_body">Ứng dụng hiển thị quảng cáo để duy trì miễn phí. Danh bạ và cuộc gọi của bạn không bao giờ được chia sẻ với mạng quảng cáo.</string>
    <string name="about_on_device">Dữ liệu của bạn luôn riêng tư</string>
    <string name="about_on_device_body">Danh bạ, nhật ký cuộc gọi và tin nhắn được xử lý trên điện thoại và không bao giờ được tải lên.</string>

    <string name="privacy_intro">Quyền riêng tư của bạn rất quan trọng. Chính sách này giải thích ứng dụng truy cập những gì và vì sao. Tóm lại: danh bạ và cuộc gọi của bạn luôn nằm trên thiết bị.</string>
    <string-array name="privacy_titles">
        <item>Dữ liệu chúng tôi truy cập</item>
        <item>Cách sử dụng dữ liệu của bạn</item>
        <item>Quảng cáo, cài đặt và phân tích</item>
        <item>Số bị chặn</item>
        <item>Lựa chọn của bạn</item>
        <item>Thay đổi</item>
    </string-array>
    <string-array name="privacy_bodies">
        <item>Khi được bạn cho phép, ứng dụng sẽ đọc và chỉnh sửa danh bạ, lịch sử cuộc gọi, thực hiện cuộc gọi và hiển thị thông báo. Ảnh bạn chọn cho một liên hệ chỉ được dùng để đặt ảnh cho liên hệ đó.</item>
        <item>Dữ liệu của bạn chỉ được dùng để hiển thị danh bạ, cuộc gọi và tên người gọi trong ứng dụng. Dữ liệu được xử lý trên thiết bị và không bao giờ được tải lên, bán hay chia sẻ.</item>
        <item>Ứng dụng dùng Internet để hiển thị quảng cáo (Google AdMob, Google Ad Manager và TradPlus cùng các đối tác), tải cài đặt ứng dụng và phân tích sử dụng ẩn danh. Các dịch vụ này có thể dùng mã nhận dạng quảng cáo của thiết bị. Danh bạ, nhật ký cuộc gọi và tin nhắn của bạn không bao giờ được gửi cho họ.</item>
        <item>Các số bị chặn được lưu trong danh sách chặn của hệ thống Android để vẫn hoạt động với các tính năng khác của điện thoại.</item>
        <item>Bạn có thể thu hồi bất kỳ quyền nào vào bất cứ lúc nào trong cài đặt điện thoại. Các cài đặt bạn chọn trong ứng dụng chỉ được lưu trên thiết bị này và sẽ bị xóa khi bạn gỡ cài đặt ứng dụng.</item>
        <item>Nếu chính sách này thay đổi, phiên bản cập nhật sẽ được đưa vào bản cập nhật ứng dụng.</item>
    </string-array>

